{
  "name": "multi-credits-pool",
  "version": "0.5.0",
  "description": "多账号 WorkBuddy：管理登录凭据、每天自动签到、汇总各账号积分与套餐，并把多账号模型轮换注册成 DSH 的原生 provider（无本地代理）",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "bin",
    "src",
    "docs",
    "README.md",
    "TESTING.md"
  ],
  "bin": {
    "multi-credits-pool": "bin/credits.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "multi-account"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dzdeng7-sudo/multi-credits-pool.git"
  },
  "homepage": "https://github.com/dzdeng7-sudo/multi-credits-pool#readme",
  "bugs": {
    "url": "https://github.com/dzdeng7-sudo/multi-credits-pool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
